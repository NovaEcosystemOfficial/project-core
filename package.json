    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "test:foundations": "tsx scripts/test-foundations.ts",
    "test:settings": "tsx scripts/test-settings.ts",
    "test:backup": "tsx scripts/test-backup.ts",
    "test:parties": "tsx scripts/test-parties.ts",
    "test:csv-export": "tsx scripts/test-csv-export.ts",
    "test:quotes": "tsx scripts/test-quotes.ts",
    "test:company-profile": "tsx scripts/test-company-profile.ts",
    "test:pdf-export": "tsx scripts/test-pdf-export.ts",
    "test:pdf-render": "electron scripts/test-pdf-render.mjs",
    "test:sector": "tsx scripts/test-sector.ts",
    "test:articles": "tsx scripts/test-articles.ts",
    "test:stock-movements": "tsx scripts/test-stock-movements.ts",
    "test:setup-wizard": "tsx scripts/test-setup-wizard.ts",
